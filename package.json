{
  "name": "duskmoon-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/css/*",
    "packages/elements/base",
    "packages/elements/elements",
    "packages/elements/art-elements",
    "packages/elements/components/*",
    "packages/elements/art/*",
    "packages/react/components",
    "packages/react/art-components",
    "apps/*",
    "phoenix/apps/*"
  ],
  "scripts": {
    "build": "bun run build:packages",
    "build:packages": "bun scripts/js/workspace.mjs build",
    "build:apps": "bun scripts/js/workspace.mjs build-apps",
    "test": "bun run test:packages",
    "test:packages": "bun scripts/js/workspace.mjs test",
    "check:impacted": "bun scripts/js/workspace.mjs check",
    "plan:impacted": "bun scripts/js/workspace.mjs plan",
    "verify:react-boundary": "bun scripts/js/react-boundary.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "20.11.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.6.1",
    "bundlesize": "^0.18.2",
    "del-cli": "7.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "globals": "17.11.0",
    "happy-dom": "20.11.6",
    "postcss": "8.5.29",
    "postcss-js": "5.1.0",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "katex": "0.18.2"
  }
}
