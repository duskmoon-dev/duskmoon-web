  "scripts": {
    "build": "bun run sync:version && rm -rf dist && bun run build:js && bun run build:types && bun run build:css",
    "build:js": "bun run build.ts",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly && bun ../../../scripts/js/resolve-declarations.mjs",
    "build:css": "bun run scripts/build-css.ts",
    "test": "bun run sync:version && bun test --preload ../test/setup.ts",
    "test:a11y": "bun run sync:version && bun test --preload ../test/setup.ts src/**/*.test.tsx",
    "typecheck": "bun run sync:version && tsc --noEmit",
    "parity:components": "bun run scripts/check-component-parity.ts",
    "sync:version": "bun run scripts/sync-version.ts",
    "size": "GITHUB_TOKEN= BUNDLESIZE_GITHUB_TOKEN= github_token= bundlesize_github_token= bundlesize"
  },
  "bundlesize": [
    {
      "path": "./dist/index.js",
      "maxSize": "120 kB"
    },
    {
      "path": "./dist/chunk-*.js",
      "maxSize": "100 kB"
    },
    {
      "path": "./dist/infrastructure.js",
      "maxSize": "100 kB"
    },
    {
      "path": "./dist/classes/**/*.js",
      "maxSize": "100 kB"
    },
    {
      "path": "./dist/components/**/*.js",
      "maxSize": "100 kB"
    },
    {
      "path": "./dist/theme/**/*.js",
      "maxSize": "100 kB"
    },
    {
      "path": "./dist/utils/**/*.js",
      "maxSize": "100 kB"
    }
  ],
