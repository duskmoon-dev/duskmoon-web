{
  "name": "duskmoonui-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:css --watch",
    "build": "bun run build:css",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css",
    "serve": "bun run build && python3 -m http.server 8000 --directory ."
  },
  "devDependencies": {
    "@duskmoon-dev/core": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
